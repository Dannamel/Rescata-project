{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "Frontend",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "donations-route": {
        "ClusterId": "donations-cluster",
        "CorsPolicy": "Frontend",
        "Match": {
          "Path": "/donations/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/donations" }
        ]
      },
      "pickups-route": {
        "ClusterId": "pickups-cluster",
        "CorsPolicy": "Frontend",
        "Match": {
          "Path": "/pickups/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/pickups" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5223/"
          }
        }
      },
      "donations-cluster": {
        "Destinations": {
          "donations": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "pickups-cluster": {
        "Destinations": {
          "pickups": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
